{
  "name": "heritagehub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "test:concurrency": "tsx --env-file=.env.local scripts/concurrency-test.ts",
    "lint": "next lint --dir src",
    "test": "vitest run tests/unit.test.ts tests/features.test.ts tests/new-features.test.ts tests/security.test.ts tests/support-sla.test.ts tests/reconcile.test.ts tests/einvoice.test.ts tests/heritage-search.test.ts tests/heritage-import.test.ts tests/heritage-api.test.ts tests/heritage-booking.test.ts tests/api-cache.test.ts",
    "test:integration": "vitest run tests/integration.test.ts tests/features.integration.test.ts tests/new-features.integration.test.ts tests/revision4.integration.test.ts tests/security.integration.test.ts",
    "test:e2e": "tsx --env-file=.env.local scripts/e2e.ts",
    "test:a11y": "tsx scripts/a11y.ts",
    "heritage:build": "tsx --env-file=.env.local scripts/heritage/build-catalogue.ts",
    "heritage:import": "tsx --env-file=.env.local scripts/heritage/import-catalogue.ts",
    "heritage:check": "tsx --env-file=.env.local scripts/heritage/check-photos.ts",
    "heritage:photo": "tsx --env-file=.env.local scripts/heritage/set-photo.ts",
    "heritage:booking": "tsx --env-file=.env.local scripts/heritage/enable-booking.ts"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@types/three": "^0.187.0",
    "@vercel/blob": "^2.8.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "jose": "^5.9.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.452.0",
    "mongoose": "^8.7.0",
    "next": "14.2.15",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.13.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.4",
    "three": "^0.187.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.16.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "jsdom": "^30.1.2",
    "node-html-parser": "^9.0.7",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
